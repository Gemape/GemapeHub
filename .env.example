# Loopback é o padrão seguro. Preencha com o IP da interface VPN real.
VPN_HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
# Endereço interno real do PostgreSQL, usado pelo processo de migração.
DB_INTERNAL_IP=
DATABASE_URL=
# Supabase auto-hospedado/acessível pela VPN. Nunca use service role em VITE_*.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# A demonstração é o padrão. Defina false somente ao ativar Auth e banco reais.
VITE_DEMO_MODE=true
# A aplicação não confia em X-Forwarded-For; configure o proxy no servidor da VPN.
