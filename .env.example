# Loopback é o padrão seguro. Preencha com o IP da interface VPN real.
VPN_HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
# Endereço interno real do PostgreSQL, usado pelo processo de migração.
DB_INTERNAL_IP=
DATABASE_URL=
# Supabase (painel: Project Settings > API). Nunca use service role em VITE_*.
# Navegador (obrigatórias para o login abrir): VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY.
# Servidor (/health e /api/admin/users): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY e SUPABASE_SERVICE_ROLE_KEY.
# Para ver as telas sem banco, use VITE_DEMO_MODE=true (dados fictícios, sem autenticação real).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# A aplicação não confia em X-Forwarded-For; configure o proxy no servidor da VPN.
