# Variáveis de ambiente do GEMAPE Hub. Copie para .env e preencha. Nunca versione o .env.
# Na Vercel, configure em Project Settings > Environment Variables (nunca no repositório).
# Sem nenhuma variável o app abre em modo demonstração, com dados fictícios salvos no navegador.

# ---------------------------------------------------------------------------
# Navegador (entram no build; precisam do prefixo VITE_)
# ---------------------------------------------------------------------------
# Modo demonstração. "true" ou ausente: sem login real e sem banco.
# "false": liga o Supabase Auth e o banco reais (exige as duas variáveis abaixo).
VITE_DEMO_MODE=true
# URL do projeto Supabase (painel: Project Settings > API > Project URL).
VITE_SUPABASE_URL=
# Chave pública do Supabase ("publishable" ou "anon" key). Nunca use a service role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Servidor (lidas em tempo de execução; não vão para o navegador)
# ---------------------------------------------------------------------------
# Mesma URL do projeto Supabase, usada por /health e pela tela de Usuários.
SUPABASE_URL=
# Mesma chave pública, usada pelo servidor.
SUPABASE_PUBLISHABLE_KEY=
# Chave service role. Só para a tela de Usuários e permissões (criar, ativar, mudar papel).
# Segredo: nunca em VITE_* e nunca no repositório.
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do app. Usado no link de recuperação de senha e na checagem de origem da API.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Somente execução própria na VPN (npm start). Não se aplicam à Vercel.
# ---------------------------------------------------------------------------
# IP privado da interface VPN onde o servidor escuta. IP público ou curinga é recusado.
VPN_HOST=127.0.0.1
# Porta do servidor.
PORT=3000
# Endereço interno do PostgreSQL e string de conexão, usados só para aplicar migrations.
DB_INTERNAL_IP=
DATABASE_URL=
# A aplicação não confia em X-Forwarded-For; configure o proxy no servidor da VPN.

# ---------------------------------------------------------------------------
# Opcionais (Lovable Cloud)
# ---------------------------------------------------------------------------
# Segredo das rotinas agendadas do Lovable. Deixe vazio se não usar.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
